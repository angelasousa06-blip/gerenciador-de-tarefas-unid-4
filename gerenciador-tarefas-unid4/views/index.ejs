<%- include('partials/header', { tituloPagina }) %>

<main class="container">

    <section class="card usuario-logado">

        <div>
            <p>
                Usuário logado:
                <strong><%= usuario.nome %></strong>
            </p>

            <p>
                Perfil:
                <strong><%= usuario.perfil %></strong>
            </p>
        </div>

        <form
            action="/logout"
            method="POST"
        >
            <button
                type="submit"
                class="secundario"
            >
                Sair
            </button>
        </form>

    </section>

    <section class="card">

        <h2>Nova tarefa</h2>

        <p class="texto-apoio">
            O formulário envia os dados ao servidor.
            O Sequelize persiste a tarefa no MariaDB.
            Esta rota agora exige usuário autenticado.
        </p>

        <form
            action="/tarefas"
            method="POST"
        >

            <div class="campo">
                <label for="titulo">
                    Título
                </label>

                <input
                    type="text"
                    id="titulo"
                    name="titulo"
                    placeholder="Ex.: Estudar autenticação"
                    required
                >
            </div>

            <div class="campo">
                <label for="descricao">
                    Descrição
                </label>

                <textarea
                    id="descricao"
                    name="descricao"
                    rows="4"
                    placeholder="Descreva a tarefa"
                ></textarea>
            </div>

            <div class="acoes-formulario">
                <button type="submit">
                    Cadastrar tarefa
                </button>
            </div>

        </form>

    </section>

    <section class="card">

        <div class="topo-lista">
            <div>
                <h2>Tarefas cadastradas</h2>

                <p class="texto-apoio">
                    Dados persistidos no banco MariaDB.
                </p>
            </div>

            <strong>
                Total: <%= tarefas.length %>
            </strong>
        </div>

        <div class="lista-tarefas">

            <% if (tarefas.length === 0) { %>

                <div class="vazio">
                    Nenhuma tarefa cadastrada.
                </div>

            <% } else { %>

                <% tarefas.forEach(tarefa => { %>

                    <article
                        class="tarefa <%= tarefa.status === 'concluida' ? 'tarefa-concluida' : '' %>"
                    >

                        <h3>
                            <%= tarefa.titulo %>
                        </h3>

                        <% if (tarefa.descricao) { %>

                            <p>
                                <%= tarefa.descricao %>
                            </p>

                        <% } else { %>

                            <p>
                                Sem descrição.
                            </p>

                        <% } %>

                        <span class="status">
                            Status:
                            <%= tarefa.status %>
                        </span>

                        <div class="acoes-tarefa">

                            <form
                                action="/tarefas/<%= tarefa.id %>/status"
                                method="POST"
                            >
                                <button
                                    type="submit"
                                    class="sucesso"
                                >
                                    <%= tarefa.status === 'concluida'
                                        ? 'Reabrir'
                                        : 'Concluir' %>
                                </button>
                            </form>

                            <% if (usuario.perfil === 'admin') { %>

                                <form
                                    action="/tarefas/<%= tarefa.id %>/excluir"
                                    method="POST"
                                    onsubmit="return confirm('Deseja realmente excluir esta tarefa?');"
                                >
                                    <button
                                        type="submit"
                                        class="perigo"
                                    >
                                        Excluir
                                    </button>
                                </form>

                            <% } %>

                        </div>

                    </article>

                <% }); %>

            <% } %>

        </div>

    </section>

    <section class="card">

        <h2>Observe no laboratório</h2>

        <p>
            Tente acessar a página principal sem login.
            O sistema deverá redirecionar para a tela de login.
        </p>

        <p>
            Faça login com o usuário administrador,
            cadastre tarefas, altere status e exclua registros.
        </p>

        <p>
            Depois clique em sair e tente acessar a página principal novamente.
        </p>

        <p>
            Também acesse uma rota inexistente, como
            <strong>/rota-inexistente</strong>,
            e observe o erro 404.
        </p>

    </section>

</main>

<%- include('partials/footer') %>
